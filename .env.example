# Root of the HomeCreator API, including /api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Google Sign-In: the Web OAuth client ID (empty = no Google button).
VITE_GOOGLE_CLIENT_ID=922271245014-t4chlnd9j1e1bhjnsamta01a49aqa8tc.apps.googleusercontent.com

# Google Analytics 4 Measurement ID. Leave empty locally (no analytics); production sets it in
# .env.production. Set it here only to test with GA4 DebugView (local builds report as debug).
VITE_GA_MEASUREMENT_ID=
